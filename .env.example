# Copy to .env.local. Use a dedicated PostgreSQL database.
DATABASE_URL=postgresql://localhost/selectaiagents_dev
BETTER_AUTH_URL=http://127.0.0.1:3100
# Generate a secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Optional fictional catalog examples; never routed or included in rankings.
SHOW_DEMO_AGENTS=false

# Exact, reviewed upstream hostnames. HTTPS/public addresses only.
ROUTER_ALLOWED_HOSTS=api.your-agent.example
# Local fixture escape hatch, ignored in production. Keep false normally.
ALLOW_LOCAL_UPSTREAM=false
# MAKER_EXAMPLE_TOKEN=... (referenced only by operator endpoint approval)

# Required for production verification and password-reset emails.
SMTP_URL=
MAIL_FROM=

# Optional until payments are enabled. Use Stripe test mode for staging.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
