# Copy to .env.staging.local (ignored by Git), or configure the hosting secret manager.
# Next.js does not automatically load .env.staging.local. Deploy these values as
# server environment variables; use the explicit migration command in docs/STAGING.md.
NODE_ENV=production
DATABASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
SHOW_DEMO_AGENTS=false
ALLOW_LOCAL_UPSTREAM=false

# Exact public HTTPS hostname of the reviewed agent; no scheme or path.
ROUTER_ALLOWED_HOSTS=
# Dedicated agent Bearer credential, selected by name during operator approval.
MAKER_STAGING_AGENT_TOKEN=
# Existing verified account IDs. The reviewer must differ from the agent owner.
OPERATOR_USER_IDS=

# Required for new staging accounts to sign up and verify their email.
SMTP_URL=
MAIL_FROM=

# Stripe TEST MODE only. The webhook secret belongs to this staging endpoint.
# Optional only when using an already-funded staging account and skipping checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
